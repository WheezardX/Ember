# Copy to `.secrets.toml` (git-ignored) and fill in your keys. Values MUST be quoted.
# Where to get each key + how to regenerate: docs/CREDENTIALS.md
# A missing key just skips that feed (best-effort); the rest of the bundle still builds.

# NASA FIRMS active-fire hotspots (B3).
# Self-service, issued instantly: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY = "your_firms_map_key"

# Synoptic Data / MesoWest RAWS observations (C3).
# Generate a TOKEN (not the API key) in the Customer Console: https://customer.synopticdata.com/
SYNOPTIC_TOKEN = "your_synoptic_token"
