# Normalize line endings: LF in the repo, checked out native on each OS.
* text=auto eol=lf

# Binary assets (should be gitignored anyway, but be explicit).
*.tif binary
*.stl binary
*.glb binary
*.laz binary
*.copc binary
*.png binary

# UE binary assets (generated by assets/generators; see EPIC_5_PLAN §3)
*.uasset binary
*.umap binary
